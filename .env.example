# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (ele já está no .gitignore).

# OBRIGATÓRIA: a aplicação não inicia sem ela. Gere uma chave aleatória com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = modo desenvolvimento (recarrega ao salvar e mostra o depurador).
# Deixe 0 em qualquer ambiente acessível por outras pessoas.
FLASK_DEBUG=0

# 1 = APAGA o banco e recria os dados de demonstração toda vez que
# "python app.py" inicia (cadastros feitos durante os testes somem).
# Use só localmente, para apresentações e testes manuais.
RESET_DB_ON_START=0

# Porta do "python app.py" (padrão 5000). Útil se a 5000 estiver ocupada.
PORT=5000

# Usada a partir da Etapa 11 (assistente de IA na criação de tarefas).
OPENAI_API_KEY=

# Opcional: só preencha se quiser usar um banco diferente do SQLite padrão
# (ajudala.db na raiz do projeto).
DATABASE_URL=
