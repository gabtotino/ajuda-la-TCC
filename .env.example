# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (ele já está no .gitignore).

# Gere uma chave aleatória, por exemplo com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Usada a partir da Etapa 11 (assistente de IA na criação de tarefas).
OPENAI_API_KEY=

# Opcional: só preencha se quiser usar um banco diferente do SQLite padrão
# (ajudala.db na raiz do projeto).
DATABASE_URL=
